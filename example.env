# Use the "help" command to see more details and available commands.

# Current Working Directory
CWD=

# Port for the HTTP API server (default: 3000)
PORT=3000

# Enable or disable startup indexing (default: true)
# Set to false to skip automatic indexing when the server starts
ENABLE_STARTUP_INDEXING=true

# Enable or disable periodic dashboard refresh (default: true)
# Set to false to stop the background task that recomputes dashboard stats
ENABLE_DASHBOARD_REFRESH=true

# Enable or disable duplicate folder groups materialization refresh (default: true)
# Set to false to stop the background task that materializes duplicate folder groups
ENABLE_DUPLICATE_FOLDER_GROUPS_REFRESH=true

# Interval in seconds for duplicate folder groups materialization refresh (default: 120)
DUPLICATE_FOLDER_GROUPS_REFRESH_INTERVAL=120