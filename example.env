# Use the "help" command to see more details and available commands.

# Current Working Directory
CWD=

# SQLite database path (default: derived from the CWD folder name,
# relative to the working directory — set an absolute path for persistence)
#DATABASE_URL=/var/lib/file-indexer/file_index.db

# Port for the HTTP API server (default: 3000)
PORT=3000

# Enable or disable startup indexing (default: true)
# Set to false to skip automatic indexing when the server starts
ENABLE_STARTUP_INDEXING=true

# Enable or disable the initial dashboard refresh at startup (default: true)
# Set to false to skip the one-time dashboard stats refresh on startup
ENABLE_INITIAL_DASHBOARD_REFRESH=true

# Enable or disable periodic dashboard refresh (default: true)
# Set to false to stop the background task that recomputes dashboard stats
ENABLE_DASHBOARD_REFRESH=true

# Enable or disable duplicate folder groups materialization refresh (default: true)
# Set to false to stop the background task that materializes duplicate folder groups
ENABLE_DUPLICATE_FOLDER_GROUPS_REFRESH=true

# Interval in seconds for duplicate folder groups materialization refresh (default: 120)
DUPLICATE_FOLDER_GROUPS_REFRESH_INTERVAL=120

# Enable or disable near-duplicate folder detection refresh (default: true)
# Finds folders sharing 80%+ of content via MinHash + LSH
ENABLE_NEAR_DUPLICATE_FOLDERS_REFRESH=true

# Interval in seconds for near-duplicate folders refresh (default: 300)
NEAR_DUPLICATE_FOLDERS_REFRESH_INTERVAL=300

# Minimum Jaccard similarity for near-duplicate pairs, 0.05–1.0 (default: 0.8)
NEAR_DUPLICATE_MIN_SIMILARITY=0.8

# Ignore "stopped by user" flags persisted in the database (default: false).
# When true, processes always start from the ENV enable flags.
IGNORE_PROCESS_DATABASE_STATE=false